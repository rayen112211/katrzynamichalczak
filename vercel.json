{
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "katrzynamichalczak.vercel.app" }],
      "destination": "https://www.katarzynaklaumichalczak.pl/:path*",
      "permanent": true
    },
    { "source": "/warsztaty/", "destination": "/kontakt/", "permanent": true },
    { "source": "/en/workshops/", "destination": "/en/work-with-me/", "permanent": true },
    { "source": "/es/talleres/", "destination": "/es/colaboraciones/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
